# Copy to .env (never commit .env). Every value is optional; defaults are shown.

# Gemini key the backend spends on demo traffic. Without it the demo answers 503
# and bring-your-own-key still works. Use a key from a project with no billing attached.
BACKEND_GEMINI_KEY=

# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite   # empty disables the fallback
# GEMINI_TIMEOUT_SECONDS=30                     # per model call
# DEMO_REQUEST_LIMIT=10          # per device, for its lifetime
# DEMO_IP_DAILY_LIMIT=30         # per client IP, per UTC day
# DEMO_GLOBAL_DAILY_LIMIT=300    # whole demo, per UTC day (tune to your Gemini quota)
# TRUST_FORWARDED_FOR=false      # true only behind a proxy you control
# DATABASE_URL=sqlite:///./askoverlay.db
# LOG_LEVEL=INFO
